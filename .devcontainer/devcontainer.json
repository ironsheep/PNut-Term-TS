// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "Pnut TermDebug TypeScript Development",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.override.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/PNut-Term-TS",
  "containerEnv": {
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "remoteUser": "node",
  "initializeCommand": "test -f .devcontainer/docker-compose.override.yml || echo 'services: {}' > .devcontainer/docker-compose.override.yml",
  "postCreateCommand": "sudo mkdir -p /Users/stephen && sudo ln -sfn /opt/container-tools /Users/stephen/container-tools; sudo chown -R node:node /home/node/.local 2>/dev/null || true; cat /workspaces/PNut-Term-TS/.bashrc >> ~/.bashrc; npm install; export PATH=\"$HOME/.local/bin:$PATH\"; claude --update || true;",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "pflannery.vscode-versionlens",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "auchenberg.vscode-browser-preview",
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "johnnywong.vscode-ts-whitespace-converter",
        "sj0000e.hexdiff",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 2,
        "terminal.integrated.shell.linux": "/bin/bash",
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
