# =============================================================
# Local mounts override (NOT committed to git)
# =============================================================
# Copy this file to docker-compose.local.yml and customize
# the paths below for your machine.
#
# If docker-compose.local.yml doesn't exist, an empty one is
# auto-created so the container still starts without errors.
# =============================================================
services:
  dev:
    volumes:
      # Claude Code configuration (authentication, settings)
      - ${HOME}/.claude:/root/.claude
      # SSH keys for git operations inside the container
      - ${HOME}/.ssh:/tmp/.ssh
      # Pascal reference source (adjust to your local copy)
      # - /path/to/PNut-REF:/pascal-source
      # Additional shared tools
      # - /path/to/container-tools:/opt/container-tools
