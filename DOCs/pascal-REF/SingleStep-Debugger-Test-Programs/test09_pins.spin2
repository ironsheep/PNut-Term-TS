'' =============================================================================
'' Single-Step Debugger Test Program 09 — Pin registers (DIR/OUT/IN)
''
'' Covers Test Plan test:
''   Test 9 — DIR/OUT/IN binary display; status indicators (INIT, STALLI, etc.)
''
'' Behavior: Drives pin 0 high, pin 1 low, pin 16 high, and floats pin 2.
''   Expected PIN panel after stepping past all four instructions:
''     DIR: bits 0, 1, 16 = 1   (pin 2 = 0 because fltl turned it off)
''     OUT: bits 0, 16 = 1; bit 1 = 0
''     IN : reflects whatever the hardware senses on those pins
''
'' Pins 62 and 63 are TX/RX and should never appear driven by this program.
'' =============================================================================
CON
  _clkfreq = 200_000_000
  DEBUG_MAIN = 1

PUB main()
  coginit(0, @entry, 0)

DAT
                org
entry           drvh    #0                       ' DIR=1, OUT=1 on pin 0
                drvl    #1                       ' DIR=1, OUT=0 on pin 1
                drvh    #16                      ' DIR=1, OUT=1 on pin 16
                fltl    #2                       ' DIR=0, OUT=0 on pin 2
                jmp     #entry
