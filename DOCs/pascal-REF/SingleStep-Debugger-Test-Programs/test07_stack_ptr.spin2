'' =============================================================================
'' Single-Step Debugger Test Program 07 — SFR, Stack, Pointers
''
'' Covers Test Plan test:
''   Test 7 — SFR values (PTRA/PTRB), hub writes via pointer, call/return stack
''
'' PASM-only program: cog 0 boots directly into this DAT at $000, so DEBUG_MAIN
'' breaks on the FIRST instruction (entry / mov ptra,##$1000) — no Spin
'' interpreter or coginit indirection in the way.
''
'' Behavior: Loads PTRA=$1000, PTRB=$2000. Writes $DEADBEEF to [PTRA] and
'' $CAFEBABE to [PTRB]. Calls a subroutine, returns, loops. The SFR panel
'' reflects PTRA/PTRB; stepping through 'call' lights up STK0.
'' =============================================================================
CON
  _clkfreq = 200_000_000
  DEBUG_MAIN = 1

DAT
                org
entry           mov     ptra, ##$1000
                mov     ptrb, ##$2000
                mov     pa, ##$DEADBEEF
                wrlong  pa, ptra                 ' hub[$1000] := $DEADBEEF
                mov     pa, ##$CAFEBABE
                wrlong  pa, ptrb                 ' hub[$2000] := $CAFEBABE
                call    #subroutine
                jmp     #entry

subroutine      nop
                ret
