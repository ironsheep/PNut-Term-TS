'' =============================================================================
'' Single-Step Debugger Test Program 06 — Flags, SKIP, XBYTE, CT
''
'' Covers Test Plan test:
''   Test 6 — Header display: C/Z flags, SKIP pattern with strikethrough, CT,
''            XBYTE, PC
''
'' PASM-only program: cog 0 boots directly into this DAT at $000, so DEBUG_MAIN
'' breaks on the FIRST instruction (entry / mov pa,#5) — no Spin interpreter or
'' coginit indirection in the way.
''
'' Behavior: Sets Z then C by compare, sets a SKIP pattern %1010 over the next
'' four NOPs (the 2nd and 4th NOPs are skipped — a SET bit means skip), then
'' loops. Stepping through shows the SKIP 32-bit pattern in the header and
'' strikethrough on the skipped disasm lines.
'' =============================================================================
CON
  _clkfreq = 200_000_000
  DEBUG_MAIN = 1

DAT
                org
entry           mov     pa, #5
                cmp     pa, #5          wz       ' Sets Z flag (equal)
                cmp     pa, #9          wc       ' Sets C flag: P2 CMP..WC sets C on unsigned borrow (5 < 9 -> C=1)
                skip    #%1010                   ' SET bit = skip; %1010 -> skip 2nd & 4th
                nop                              ' bit 0 = 0 -> executes (NOT skipped)
                nop                              ' bit 1 = 1 -> skipped
                nop                              ' bit 2 = 0 -> executes (NOT skipped)
                nop                              ' bit 3 = 1 -> skipped
                jmp     #entry
