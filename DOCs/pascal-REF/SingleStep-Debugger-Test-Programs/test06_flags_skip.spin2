'' =============================================================================
'' Single-Step Debugger Test Program 06 — Flags, SKIP, XBYTE, CT
''
'' Covers Test Plan test:
''   Test 6 — Header display: C/Z flags, SKIP pattern with strikethrough, CT,
''            XBYTE, PC
''
'' PASM-only program: cog 0 boots directly into this DAT at $000, so DEBUG_MAIN
'' breaks on the FIRST instruction (entry / mov pa,#5) — no Spin interpreter or
'' coginit indirection in the way.
''
'' Behavior: Sets Z then C by compare, sets a SKIP pattern %1010 over the next
'' four NOPs (pins 0 and 2 skipped), then loops. Stepping through shows the
'' SKIP 32-bit pattern in the header and strikethrough on skipped disasm lines.
'' =============================================================================
CON
  _clkfreq = 200_000_000
  DEBUG_MAIN = 1

DAT
                org
entry           mov     pa, #5
                cmp     pa, #5          wz       ' Sets Z flag (equal)
                cmp     pa, #3          wc       ' Sets C flag (5 > 3)
                skip    #%1010                   ' Skip 2nd and 4th of next 4
                nop                              ' skipped (bit 0 = 0)
                nop                              ' not skipped (bit 1 = 1)
                nop                              ' skipped (bit 2 = 0)
                nop                              ' not skipped (bit 3 = 1)
                jmp     #entry
